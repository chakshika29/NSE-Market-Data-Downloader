        "loosers": "https://www.nseindia.com/api/live-analysis-variations?index=loosers"
      },
      "section": "allSec",
      "fallback_sections": ["NIFTY", "FOSec"],
      "timestamp_path": ["allSec", "timestamp"],
      "required_fields": ["symbol", "ltp", "category"],
      "dedup_keys": ["symbol", "series", "category"],
      "numeric_fields": ["open_price", "high_price", "low_price", "ltp", "prev_price", "perChange"],
      "column_order": [
        "symbol",
        "series",
        "category",
        "open_price",
        "high_price",
        "low_price",
        "ltp",
        "prev_price",
        "net_price",
        "perChange",
        "trade_quantity",
        "turnover"
      ]
    },
