# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & sensitive configuration
.env
*.env
.env.*

# Database files
*.db
*.sqlite
*.sqlite3

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs (exclude runtime log files, preserve directory)
logs/*.log
logs/*.log.*
!logs/.gitkeep

# Output generated data (keep directory structure and CSV files, exclude temporary/scratch files)
output/*.tmp
output/*.db
output/*.sqlite
output/*.sqlite3
!output/.gitkeep
!output/*.csv

# OS generated files
.DS_Store
Thumbs.db
